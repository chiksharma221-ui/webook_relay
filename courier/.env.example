# Copy to .env for local runs outside Docker. Every setting is optional except DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courier
# COURIER_API_KEY=change-me                  # require "Authorization: Bearer <key>" on /v1
# COURIER_ALLOW_PRIVATE_URLS=false           # SSRF guard; true only for local development
# COURIER_WORKER_CONCURRENCY=200
# COURIER_RETRY_SCHEDULE=5,30,120,600,1800,3600,10800,21600,43200
# COURIER_MAX_ATTEMPTS=10
# COURIER_REQUEST_TIMEOUT=10
# COURIER_LEASE_SECONDS=60
# COURIER_CIRCUIT_THRESHOLD=5
# COURIER_CIRCUIT_COOLDOWN=60
# COURIER_DB_POOL_SIZE=20
